# Git ignore file for SLAMDUNK card gallery

# System files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp

# Large image files - explicitly allow card gallery images
# Card gallery images (use ! to negate ignore)
!images/goods/slamdunk/card/1997CardassMasters/*.jpg
!images/goods/slamdunk/card/1997CardassMasters/*.jpeg
!images/goods/slamdunk/card/1997CardassMasters/*.png
!images/goods/slamdunk/card/1997CardassMasters/*.gif
!images/goods/slamdunk/card/1997CardassMasters/*.webp
!images/goods/slamdunk/card/1997CardassMasters/*.avif

!images/goods/slamdunk/card/seriesB/*.jpg
